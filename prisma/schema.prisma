generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Plan {
  FREE
  SOLO
  GROWTH
  AGENCY
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum QBRStatus {
  DRAFT
  GENERATED
  EXPORTED
}

enum BrandingMode {
  PLATFORM_BRANDED
  WHITE_LABEL
}

enum ExportType {
  PDF
  PPTX
}

enum StripeEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

// ─── Workspace ────────────────────────────────────────────────────────────────

model Workspace {
  id           String            @id @default(cuid())
  name         String
  slug         String?           @unique
  logoUrl      String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime? // NEW — soft delete / archive
  clients      Client[]
  qbrs         QBR[] // NEW — direct workspace→QBR relation
  exportEvents ExportEvent[]     @relation("WorkspaceExports")
  shareLinks   ShareLink[] // NEW
  subscription Subscription?
  invites      WorkspaceInvite[]
  members      WorkspaceMember[]

  @@index([deletedAt])
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id             String            @id @default(cuid())
  clerkId        String            @unique
  email          String            @unique
  name           String?
  avatarUrl      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  clientsCreated Client[]          @relation("ClientCreatedBy")
  exportEvents   ExportEvent[]     @relation("UserExports")
  qbrsCreated    QBR[]             @relation("CreatedBy")
  qbrsExported   QBR[]             @relation("ExportedBy")
  invitesSent    WorkspaceInvite[] @relation("InvitedBy")
  invitesAccepted WorkspaceInvite[] @relation("AcceptedBy") // NEW
  shareLinks     ShareLink[] // NEW
  memberships    WorkspaceMember[]
}

// ─── WorkspaceMember ──────────────────────────────────────────────────────────

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        TeamRole  @default(MEMBER)
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  // Supports "find an OWNER in this workspace" / last-owner checks
  @@index([workspaceId, role])
}

// ─── WorkspaceInvite ──────────────────────────────────────────────────────────

model WorkspaceInvite {
  id          String       @id @default(cuid())
  workspaceId String
  email       String
  role        TeamRole     @default(MEMBER)
  token       String       @unique @default(cuid())
  status      InviteStatus @default(PENDING)
  invitedById String
  createdAt   DateTime     @default(now())
  expiresAt   DateTime

  // NEW — acceptance / revocation audit
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?

  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedBy  User?     @relation("AcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull) // NEW
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  // NOTE: removed redundant @@index([token]) — `token @unique` already indexes it.
}

// ─── Subscription ─────────────────────────────────────────────────────────────

model Subscription {
  id                   String    @id @default(cuid())
  workspaceId          String    @unique
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stripeCustomerId     String    @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  plan                 Plan      @default(FREE)
  status               String    @default("active")
  currentPeriodEnd     DateTime?
  periodStart          DateTime  @default(now())
  qbrCount             Int       @default(0)
  exportCount          Int       @default(0)

  // DEPRECATED — ExportEvent is the source of truth for exports.
  // Retained temporarily for migration compatibility; remove after confirming
  // no code path reads/writes it. Do NOT treat as authoritative.
  exportedQbrIds       String    @default("[]")

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  stripeStatus             String?
  stripeCurrentPeriodStart DateTime?
  stripeCurrentPeriodEnd   DateTime?
  pastDueAt                DateTime?
  graceEndsAt              DateTime?
  cancelAtPeriodEnd        Boolean   @default(false)
}

// ─── Client ───────────────────────────────────────────────────────────────────

model Client {
  id           String        @id @default(cuid())
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // CHANGED — nullable + SetNull so deleting a creator never destroys/blocks
  // historical business records.
  createdById  String?
  createdBy    User?         @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  name         String
  industry     String?
  contactName  String?
  contactEmail String?
  userCount    Int?
  notes        String?
  nextQbrDate  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime? // NEW — soft delete / archive

  qbrs         QBR[]
  exportEvents ExportEvent[] @relation("ClientExports")

  // NEW — composite target so QBR can enforce same-workspace via composite FK.
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, nextQbrDate])
  @@index([deletedAt])
}

// ─── QBR ──────────────────────────────────────────────────────────────────────

model QBR {
  id          String @id @default(cuid())
  clientId    String
  workspaceId String // NEW — direct workspace scoping

  // CHANGED — composite FK enforces QBR.workspaceId == Client.workspaceId at the
  // database level. A QBR cannot reference a Client from another workspace.
  // onDelete: Restrict — soft-delete clients instead of cascading.
  client      Client @relation(fields: [clientId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  // NEW — direct workspace relation (Restrict; workspaces are soft-deleted).
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  createdById  String?
  createdBy    User?    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  exportedById String?
  exportedBy   User?    @relation("ExportedBy", fields: [exportedById], references: [id], onDelete: SetNull)

  quarter               String
  year                  Int
  status                QBRStatus     @default(DRAFT)
  tickets               Int?
  avgResolutionHrs      Float?
  uptimePct             Float?
  patchCompliancePct    Float?
  securityIncidents     Int?
  usersSupported        Int?
  ticketCategories      String?
  wins                  String?
  upsellOpportunities   String?
  slides                Json?
  summary               String?

  // DEPRECATED — superseded by ShareLink. Kept temporarily for transition so
  // existing links keep working. Remove only after portal + send/share routes
  // use ShareLink exclusively.
  shareToken            String?       @unique

  rawMetrics            Json?
  healthScore           Int?
  healthStatus          String?
  healthScoreVersion    String?
  scoreBreakdown        Json?
  snapshot              Json?
  generatorVersion      String?
  exportTemplateVersion String?

  // NEW — explicit versioning (duplicate same-quarter QBRs remain valid).
  version      Int       @default(1)
  supersededAt DateTime?
  isCurrent    Boolean   @default(true)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // NEW — soft delete / archive

  exportEvents ExportEvent[] @relation("QBRExports")
  shareLinks   ShareLink[] // NEW

  // Composite target so ShareLink (and any child) can enforce same-workspace
  // via composite FK [qbrId, workspaceId] -> [id, workspaceId].
  @@unique([id, workspaceId])
  @@index([clientId])
  @@index([workspaceId, createdAt])
  @@index([clientId, createdAt])
  @@index([clientId, quarter, year, createdAt])
  @@index([deletedAt])
}

// ─── ShareLink ────────────────────────────────────────────────────────────────
// Dedicated, audited public-portal link. Raw token lives ONLY in the URL;
// the database stores a SHA-256 hash. Tokens are CSPRNG-generated (>=32 bytes).

model ShareLink {
  id              String   @id @default(cuid())
  tokenHash       String   @unique // SHA-256 of the raw token; raw token never stored
  qbrId           String
  workspaceId     String
  createdByUserId String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastViewedAt    DateTime?
  viewCount       Int      @default(0)

  // Composite FK — a ShareLink cannot point at a QBR from another workspace.
  qbr       QBR       @relation(fields: [qbrId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([qbrId])
  @@index([workspaceId, createdAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

// ─── ExportEvent ──────────────────────────────────────────────────────────────
// Immutable billing/audit record. Protected from cascade destruction via
// onDelete: Restrict on its QBR/Client/Workspace relations. Denormalized
// snapshot fields are the durable human-readable record.

model ExportEvent {
  id                         String       @id
  qbrId                      String
  qbr                        QBR          @relation("QBRExports", fields: [qbrId], references: [id], onDelete: Restrict)
  workspaceId                String
  workspace                  Workspace    @relation("WorkspaceExports", fields: [workspaceId], references: [id], onDelete: Restrict)
  clientId                   String
  client                     Client       @relation("ClientExports", fields: [clientId], references: [id], onDelete: Restrict)
  exportedByUserId           String?
  exportedBy                 User?        @relation("UserExports", fields: [exportedByUserId], references: [id], onDelete: SetNull)
  exportType                 ExportType
  exportedAt                 DateTime     @default(now())
  exportPackageId            String?
  isRedownload               Boolean      @default(false)
  consumedExportCredit       Boolean      @default(false)
  brandingMode               BrandingMode
  planAtExport               Plan
  clientNameAtExport         String
  mspNameAtExport            String?
  healthScoreAtExport        Int?
  healthStatusAtExport       String?
  healthScoreVersionAtExport String?
  templateVersion            String?

  @@index([qbrId])
  @@index([workspaceId])
  @@index([clientId])
  @@index([exportPackageId])
  @@index([exportedAt])
}

// ─── StripeEvent ──────────────────────────────────────────────────────────────

model StripeEvent {
  id            String            @id @default(cuid())
  stripeEventId String            @unique
  eventType     String
  status        StripeEventStatus @default(RECEIVED)
  receivedAt    DateTime          @default(now())
  processedAt   DateTime?
  errorMessage  String?
  retryCount    Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([stripeEventId])
  @@index([status])
  @@index([eventType])
  @@index([receivedAt])
}
